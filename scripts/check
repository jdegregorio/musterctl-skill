#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ -e skills ]]; then
  echo "archive_boundary_error: this redirect must not contain skill source" >&2
  exit 1
fi

grep --fixed-strings \
  "https://github.com/jdegregorio/musterctl/tree/main/skills/musterctl" \
  README.md >/dev/null
